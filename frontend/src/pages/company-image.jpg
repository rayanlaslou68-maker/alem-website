;:&quot;&quot;,&quot;attributes&quot;:{&quot;wpvchannel&quot;:&quot;politique&quot;,&quot;orderby&quot;:&quot;date&quot;,&quot;order&quot;:&quot;DESC&quot;,&quot;cached&quot;:&quot;on&quot;},&quot;environment&quot;:{&quot;current_post_id&quot;:100078294,&quot;parent_post_id&quot;:100078294,&quot;parent_term_id&quot;:0,&quot;parent_user_id&quot;:0,&quot;archive&quot;:{&quot;type&quot;:&quot;&quot;,&quot;name&quot;:&quot;&quot;,&quot;data&quot;:[]}},&quot;loop&quot;:{&quot;type&quot;:&quot;&quot;,&quot;name&quot;:&quot;&quot;,&quot;data&quot;:[],&quot;id&quot;:0}}" data-attributes="{&quot;wpvchannel&quot;:&quot;politique&quot;,&quot;orderby&quot;:&quot;date&quot;,&quot;order&quot;:&quot;DESC&quot;,&quot;cached&quot;:&quot;on&quot;}" data-environment="{&quot;current_post_id&quot;:100078294,&quot;parent_post_id&quot;:100078294,&quot;parent_term_id&quot;:0,&quot;parent_user_id&quot;:0,&quot;archive&quot;:{&quot;type&quot;:&quot;&quot;,&quot;name&quot;:&quot;&quot;,&quot;data&quot;:[]}}"><input type="hidden" class="js-wpv-dps-filter-data js-wpv-filter-data-for-this-form" data-action="/reunion-a-rabat-du-conseil-dadministration-de-lalem-100078294/?wpv_view_count=100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294" data-page="1" data-ajax="disable" data-effect="fade" data-maxpages="1101" data-ajaxprebefore="" data-ajaxbefore="" data-ajaxafter="" /><input class="wpv_view_count wpv_view_count-100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294" type="hidden" name="wpv_view_count" value="100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294" /></form><div id="wpv-view-layout-100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294" class="js-wpv-view-layout js-wpv-layout-responsive js-wpv-view-layout-100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294 wpv-pagination js-wpv-layout-has-pagination js-wpv-layout-infinite-scrolling" data-viewnumber="100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294" data-pagination="{&quot;id&quot;:&quot;100062871&quot;,&quot;query&quot;:&quot;normal&quot;,&quot;type&quot;:&quot;ajaxed&quot;,&quot;effect&quot;:&quot;infinite&quot;,&quot;duration&quot;:500,&quot;speed&quot;:&quot;5&quot;,&quot;pause_on_hover&quot;:&quot;enabled&quot;,&quot;stop_rollover&quot;:&quot;false&quot;,&quot;cache_pages&quot;:&quot;disabled&quot;,&quot;preload_images&quot;:&quot;disabled&quot;,&quot;preload_pages&quot;:&quot;disabled&quot;,&quot;preload_reach&quot;:2,&quot;spinner&quot;:&quot;disabled&quot;,&quot;spinner_image&quot;:&quot;&quot;,&quot;callback_next&quot;:&quot;&quot;,&quot;manage_history&quot;:&quot;disabled&quot;,&quot;has_controls_in_form&quot;:&quot;disabled&quot;,&quot;infinite_tolerance&quot;:9999,&quot;max_pages&quot;:1101,&quot;page&quot;:1,&quot;base_permalink&quot;:&quot;/reunion-a-rabat-du-conseil-dadministration-de-lalem-100078294/?wpv_view_count=100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294&amp;wpv_paged=WPV_PAGE_NUM&quot;,&quot;loop&quot;:{&quot;type&quot;:&quot;&quot;,&quot;name&quot;:&quot;&quot;,&quot;data&quot;:[],&quot;id&quot;:0}}" data-permalink="/reunion-a-rabat-du-conseil-dadministration-de-lalem-100078294/?wpv_view_count=100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294"> <section aria-labelledby="articles-suggested" role="complementary"><!-- WPV_Infinite_Scroll --><!-- WPV_Infinite_Scroll_Insert --> <div class='row border-bottom m-med-top p-tp-md-b m-med-bottom'> <div class="col-12 col-sm-12 col-md-12 col-lg-5 col-xl-5 mob-container-desktop px-l0"> <a data-bg="https://e85ty3xsocd.exactdn.com/uploads/2025/06/13160708/interieur-768x417.jpg?avif=70" class="featured-right-page rocket-lazyload" href="https://www.lebrief.ma/linterieur-ouvre-une-enquete-sur-deux-bureaux-de-vote-a-tanger-100167465/" style="" aria-label="L’Intérieur ouvre une enquête sur deux bureaux de vote à Tanger"></a> </div> <div class="col-12 col-sm-12 col-md-12 col-lg-7 col-xl-7 px-l0 mob-container-mobile"><span class="title-medium"><a href="https://www.lebrief.ma/linterieur-ouvre-une-enquete-sur-deux-bureaux-de-vote-a-tanger-100167465/">L’Intérieur ouvre une enquête sur deux bureaux de vote à Tanger</a></span> <p class="p-tp-sm-top">Une commission centrale enquête à Tanger sur des irrégularités signalées dans deux bureaux de vote lors des législatives du 23 septembre 2026.</p> <small style="color:#7e7277"><span><a href="https://www.lebrief.ma/author/ilyasse-rhamir/">Ilyasse Rhamir</a> - <span>28 septembre 2026</span></span></small> </div> </div> <div class='row border-bottom m-med-top p-tp-md-b m-med-bottom'> <div class="col-12 col-sm-12 col-md-12 col-lg-5 col-xl-5 mob-container-desktop px-l0"> <a data-bg="https://e85ty3xsocd.exactdn.com/uploads/2026/08/04145507/Sebta.jpg?avif=70" class="featured-right-page rocket-lazyload" href="https://www.lebrief.ma/espagne-un-decret-pour-accelerer-les-renvois-vers-le-maroc-100167440/" style="" aria-label="Sebta: une nouvelle mobilisation redoutée à la mi-août"></a> </div> <div class="col-12 col-sm-12 col-md-12 col-lg-7 col-xl-7 px-l0 mob-container-mobile"><span class="title-medium"><a href="https://www.lebrief.ma/espagne-un-decret-pour-accelerer-les-renvois-vers-le-maroc-100167440/">Espagne : un décret pour accélérer les renvois vers le Maroc</a></span> <p class="p-tp-sm-top">L’Espagne prévoit d’adopter un décret pour accélérer le renvoi vers le Maroc de migrants en situation irrégulière à Sebta, en modifiant les procédures liées aux demandes d’asile.</p> <small style="color:#7e7277"><span><a href="https://www.lebrief.ma/author/elmehdi-el-azhary/">El Mehdi El Azhary</a> - <span>28 septembre 2026</span></span></small> </div> </div> <div class='row border-bottom m-med-top p-tp-md-b m-med-bottom'> <div class="col-12 col-sm-12 col-md-12 col-lg-5 col-xl-5 mob-container-desktop px-l0"> <a data-bg="https://e85ty3xsocd.exactdn.com/uploads/2026/09/26131610/situation-du-maire-de-tanger-une-source-dement-tout-avis-de-recherche-et-768x506.webp?avif=70" class="featured-right-page rocket-lazyload" href="https://www.lebrief.ma/situation-du-maire-de-tanger-une-source-dement-tout-avis-de-recherche-et-annonce-son-retour-lundi-100167399/" style="" aria-label="Mounir Laymouri, maire de Tanger"></a> </div> <div class="col-12 col-sm-12 col-md-12 col-lg-7 col-xl-7 px-l0 mob-container-mobile"><span class="title-medium"><a href="https://www.lebrief.ma/situation-du-maire-de-tanger-une-source-dement-tout-avis-de-recherche-et-annonce-son-retour-lundi-100167399/">Situation du maire de Tanger : une source dément tout avis de recherche et annonce son retour lundi</a></span> <p class="p-tp-sm-top">Une source locale dément tout avis de recherche contre Mounir Laymouri et assure que le maire de Tanger rentre au Maroc ce lundi.</p> <small style="color:#7e7277"><span><a href="https://www.lebrief.ma/author/redaction-lebrief/">Rédaction LeBrief</a> - <span>28 septembre 2026</span></span></small> </div> </div> <div class='row border-bottom m-med-top p-tp-md-b m-med-bottom'> <div class="col-12 col-sm-12 col-md-12 col-lg-5 col-xl-5 mob-container-desktop px-l0"> <a data-bg="https://e85ty3xsocd.exactdn.com/uploads/2026/04/09203103/Conseil-des-ministres-768x512.jpeg?avif=70" class="featured-right-page rocket-lazyload" href="https://www.lebrief.ma/le-maroc-reaffirme-son-soutien-a-larabie-saoudite-face-aux-attaques-houthies-100167423/" style="" aria-label="Le Maroc réaffirme son soutien à l’Arabie Saoudite face aux attaques houthies"></a> </div> <div class="col-12 col-sm-12 col-md-12 col-lg-7 col-xl-7 px-l0 mob-container-mobile"><span class="title-medium"><a href="https://www.lebrief.ma/le-maroc-reaffirme-son-soutien-a-larabie-saoudite-face-aux-attaques-houthies-100167423/">Le Maroc réaffirme son soutien à l’Arabie Saoudite face aux attaques houthies</a></span> <p class="p-tp-sm-top">Le roi Mohammed VI réaffirme le soutien du Maroc à l’Arabie Saoudite face aux attaques houthies et condamne les atteintes aux civils et lieux saints.</p> <small style="color:#7e7277"><span><a href="https://www.lebrief.ma/author/mouna-aghlal/">Mouna Aghlal</a> - <span>26 septembre 2026</span></span></small> </div> </div> <div class='row border-bottom m-med-top p-tp-md-b m-med-bottom'> <div class="col-12 col-sm-12 col-md-12 col-lg-5 col-xl-5 mob-container-desktop px-l0"> <a data-bg="https://e85ty3xsocd.exactdn.com/uploads/2026/09/26140959/ADFM.jpg?avif=70" class="featured-right-page rocket-lazyload" href="https://www.lebrief.ma/ladfm-presentera-les-premiers-resultats-dun-barometre-sur-la-representation-politique-des-femmes-100167409/" style="" aria-label="L’ADFM présentera les premiers résultats d’un baromètre sur la représentation politique des femmes"></a> </div> <div class="col-12 col-sm-12 col-md-12 col-lg-7 col-xl-7 px-l0 mob-container-mobile"><span class="title-medium"><a href="https://www.lebrief.ma/ladfm-presentera-les-premiers-resultats-dun-barometre-sur-la-representation-politique-des-femmes-100167409/">L’ADFM présentera les premiers résultats d’un baromètre sur la représentation politique des femmes</a></span> <p class="p-tp-sm-top">L’ADFM présentera le 28 septembre les premiers résultats de son baromètre sur la représentation politique des femmes aux législatives de 2026.</p> <small style="color:#7e7277"><span><a href="https://www.lebrief.ma/author/mouna-aghlal/">Mouna Aghlal</a> - <span>26 septembre 2026</span></span></small> </div> </div> <div class='row border-bottom m-med-top p-tp-md-b m-med-bottom'> <div class="col-12 col-sm-12 col-md-12 col-lg-5 col-xl-5 mob-container-desktop px-l0"> <a data-bg="https://e85ty3xsocd.exactdn.com/uploads/2026/09/26091229/Cover-dossier-vote-sanction-2000-768x269.jpg?avif=70" class="featured-right-page rocket-lazyload" href="https://www.lebrief.ma/legislatives-2026-vote-sanction-abstention-100167351/" style="" aria-label="Illustration du dossier sur l&#039;analyse du vote-sanction et l&#039;abstention lors du scrutin des législatives du 23 septembre 2026"></a> </div> <div class="col-12 col-sm-12 col-md-12 col-lg-7 col-xl-7 px-l0 mob-container-mobile"><span class="title-medium"><a href="https://www.lebrief.ma/legislatives-2026-vote-sanction-abstention-100167351/">Législatives 2026 : anatomie d&rsquo;un vote-sanction. Radiographie d&rsquo;une abstention</a></span> <p class="p-tp-sm-top">62% de Marocains n’ont pas voté, un râteau monumental. Anatomie d&#039;un désamour électoral. </p> <small style="color:#7e7277"><span><a href="https://www.lebrief.ma/author/sabrina-el-faiz/">Sabrina El Faiz</a> - <span>26 septembre 2026</span></span></small> </div> </div><!-- WPV_Infinite_Scroll --><span class="seemore"><a class="wpv-filter-next-link js-wpv-pagination-next-link page-link " href="/reunion-a-rabat-du-conseil-dadministration-de-lalem-100078294/?wpv_view_count=100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294&#038;wpv_paged=2" data-viewnumber="100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294" data-page="2">Voir plus</a></span> </section> </div> </div><div id="content2" class="tab-content"> <form autocomplete="off" name="wpv-filter-100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294" action="/reunion-a-rabat-du-conseil-dadministration-de-lalem-100078294/?wpv_view_count=100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294" method="get" class="wpv-filter-form js-wpv-filter-form js-wpv-filter-form-100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294 js-wpv-form-full" data-viewnumber="100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294" data-viewid="100062871" data-viewhash="eyJuYW1lIjoidmlldy1wb3VyLWxlcy1wYWdlcy1jYXRlZ29yaWVzLWJvdHRvbS1wb3VyLWxlcy1hcnRpY2xlcyIsIndwdmNoYW5uZWwiOiJwb2xpdGlxdWUiLCJvcmRlcmJ5IjoibWVudV9vcmRlciIsIm9yZGVyIjoiREVTQyIsImxpbWl0IjoiNiIsImNhY2hlZCI6Im9uIn0=" data-viewwidgetid="0" data-orderby="" data-order="" data-orderbyas="" data-orderbysecond="" data-ordersecond="" data-parametric="{&quot;query&quot;:&quot;normal&quot;,&quot;id&quot;:&quot;100062871&quot;,&quot;view_id&quot;:&quot;100062871&quot;,&qu