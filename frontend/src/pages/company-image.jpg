&quot;:0}}" data-permalink="/reunion-a-rabat-du-conseil-dadministration-de-lalem-100078294/?wpv_view_count=100062871-CATTRf542a8c9ea1db6bac8c1ff578be4488fTCPID100078294"> <section aria-labelledby="articles-suggested" role="complementary"><!-- WPV_Infinite_Scroll --><!-- WPV_Infinite_Scroll_Insert --> <div class='row border-bottom m-med-top p-tp-md-b m-med-bottom'> <div class="col-12 col-sm-12 col-md-12 col-lg-5 col-xl-5 mob-container-desktop px-l0"> <a data-bg="https://e85ty3xsocd.exactdn.com/uploads/2026/03/12104615/Enseignement-superieur-le-gouvernement-fait-le-point-sur-lavancement-de-la-reforme-768x512.jpeg?avif=70" class="featured-right-page rocket-lazyload" href="https://www.lebrief.ma/enseignement-superieur-le-gouvernement-fait-le-point-sur-lavancement-de-la-reforme-100144528/" style="" aria-label="Enseignement supérieur le gouvernement fait le point sur l’avancement de la réforme"></a> </div> <div class="col-12 col-sm-12 col-md-12 col-lg-7 col-xl-7 px-l0 mob-container-mobile"><span class="title-medium"><a href="https://www.lebrief.ma/enseignement-superieur-le-gouvernement-fait-le-point-sur-lavancement-de-la-reforme-100144528/">Enseignement supérieur : le gouvernement fait le point sur l’avancement de la réforme</a></span> <p class="p-tp-sm-top">Politique - Le gouvernement fait le point sur la réforme de l&#039;enseignement supérieur et son impact sur la recherche scientifique.</p> <small style="color:#7e7277"><span><a href="https://www.lebrief.ma/author/mouna-aghlal/">Mouna Aghlal</a> - <span>12 mars 2026</span></span></small> </div> </div> <div class='row border-bottom m-med-top p-tp-md-b m-med-bottom'> <div class="col-12 col-sm-12 col-md-12 col-lg-5 col-xl-5 mob-container-desktop px-l0"> <a data-bg="https://e85ty3xsocd.exactdn.com/uploads/2025/07/17170154/CG-768x512.jpg?avif=70" class="featured-right-page rocket-lazyload" href="https://www.lebrief.ma/conseil-de-gouvernement-adoption-de-deux-decrets-sur-la-peche-continentale-et-les-opcvm-100144596/" style="" aria-label="Conseil de gouvernement : adoption de deux décrets sur la pêche continentale et les OPCVM"></a> </div> <div class="col-12 col-sm-12 col-md-12 col-lg-7 col-xl-7 px-l0 mob-container-mobile"><span class="title-medium"><a href="https://www.lebrief.ma/conseil-de-gouvernement-adoption-de-deux-decrets-sur-la-peche-continentale-et-les-opcvm-100144596/">Conseil de gouvernement : adoption de deux décrets sur la pêche continentale et les OPCVM</a></span> <p class="p-tp-sm-top">Politique - Le Conseil de gouvernement approuve des décrets sur la pêche continentale et les OPCVM pour une meilleure organisation sectorielle.</p> <small style="color:#7e7277"><span><a href="https://www.lebrief.ma/author/mouna-aghlal/">Mouna Aghlal</a> - <span>12 mars 2026</span></span></small> </div> </div> <div class='row border-bottom m-med-top p-tp-md-b m-med-bottom'> <div class="col-12 col-sm-12 col-md-12 col-lg-5 col-xl-5 mob-container-desktop px-l0"> <a data-bg="https://e85ty3xsocd.exactdn.com/uploads/2026/03/12211330/Le-CCG-salue-le-soutien-du-Roi-Mohammed-VI-et-reaffirme-son-appui-a-la-marocanite-du-Sahara-768x512.jpg?avif=70" class="featured-right-page rocket-lazyload" href="https://www.lebrief.ma/le-ccg-salue-le-soutien-du-roi-mohammed-vi-et-reaffirme-son-appui-a-la-marocanite-du-sahara-100144606/" style="" aria-label="Agressions iraniennes : le Maroc réaffirme sa solidarité avec les pays du Golfe"></a> </div> <div class="col-12 col-sm-12 col-md-12 col-lg-7 col-xl-7 px-l0 mob-container-mobile"><span class="title-medium"><a href="https://www.lebrief.ma/le-ccg-salue-le-soutien-du-roi-mohammed-vi-et-reaffirme-son-appui-a-la-marocanite-du-sahara-100144606/">Le CCG salue le soutien du Roi Mohammed VI et réaffirme son appui à la marocanité du Sahara</a></span> <p class="p-tp-sm-top">Politique - Le CCG réaffirme son appui à la marocanité du Sahara lors de la 8e réunion ministérielle conjointe.</p> <small style="color:#7e7277"><span><a href="https://www.lebrief.ma/author/mouna-aghlal/">Mouna Aghlal</a> - <span>12 mars 2026</span></span></small> </div> </div> <div class='row border-bottom m-med-top p-tp-md-b m-med-bottom'> <div class="col-12 col-sm-12 col-md-12 col-lg-5 col-xl-5 mob-container-desktop px-l0"> <a data-bg="https://e85ty3xsocd.exactdn.com/uploads/2026/03/11184308/Deployment-of-the-2nd-Phase-of-Connected-Mobile-Medical-Units-768x511.webp?avif=70" class="featured-right-page rocket-lazyload" href="https://www.lebrief.ma/la-medecine-a-distance-pour-qui-pour-quoi-combien-100144480/" style="" aria-label="La médecine à distance, pour qui ? pourquoi ? où ?"></a> </div> <div class="col-12 col-sm-12 col-md-12 col-lg-7 col-xl-7 px-l0 mob-container-mobile"><span class="title-medium"><a href="https://www.lebrief.ma/la-medecine-a-distance-pour-qui-pour-quoi-combien-100144480/">La médecine à distance, pour qui ? pour quoi ? combien ?</a></span> <p class="p-tp-sm-top">Politique – Comment la télémédecine transforme l’accès aux soins, notamment dans les zones rurales ou enclavées ?</p> <small style="color:#7e7277"><span><a href="https://www.lebrief.ma/author/sabrina-el-faiz/">Sabrina El Faiz</a> - <span>12 mars 2026</span></span></small> </div> </div> <div class='row border-bottom m-med-top p-tp-md-b m-med-bottom'> <div class="col-12 col-sm-12 col-md-12 col-lg-5 col-xl-5 mob-container-desktop px-l0"> <a data-bg="https://e85ty3xsocd.exactdn.com/uploads/2026/03/12203047/Maroc-et-GCC-renforcent-leur-partenariat-lors-de-la-huitieme-reunion-ministerielle-conjointe-768x512.jpg?avif=70" class="featured-right-page rocket-lazyload" href="https://www.lebrief.ma/le-roi-mohammed-vi-salue-par-le-ccg-pour-son-engagement-envers-la-ville-sainte-100144609/" style="" aria-label="Nasser Bourita représente le roi Mohammed VI à l’investiture du président djiboutien"></a> </div> <div class="col-12 col-sm-12 col-md-12 col-lg-7 col-xl-7 px-l0 mob-container-mobile"><span class="title-medium"><a href="https://www.lebrief.ma/le-roi-mohammed-vi-salue-par-le-ccg-pour-son-engagement-envers-la-ville-sainte-100144609/">Le roi Mohammed VI salué par le CCG pour son engagement envers la ville sainte</a></span> <p class="p-tp-sm-top">Politique - Le CCG salue l&#039;engagement du roi Mohammed VI lors de la réunion ministérielle conjointe. Un moment fort pour le Maroc et la région.</p> <small style="color:#7e7277"><span><a href="https://www.lebrief.ma/author/mouna-aghlal/">Mouna Aghlal</a> - <span>12 mars 2026</span></span></small> </div> </div> <div class='row border-bottom m-med-top p-tp-md-b m-med-bottom'> <div class="col-12 col-sm-12 col-md-12 col-lg-5 col-xl-5 mob-container-desktop px-l0"> <a data-bg="https://e85ty3xsocd.exactdn.com/uploads/2025/04/12094719/TO-768x512.jpg?avif=70" class="featured-right-page rocket-lazyload" href="https://www.lebrief.ma/khenifra-nizar-baraka-lance-plusieurs-projets-pour-renforcer-le-reseau-routier-100144284/" style="" aria-label="Khénifra : Nizar Baraka lance plusieurs projets pour renforcer le réseau routier"></a> </div> <div class="col-12 col-sm-12 col-md-12 col-lg-7 col-xl-7 px-l0 mob-container-mobile"><span class="title-medium"><a href="https://www.lebrief.ma/khenifra-nizar-baraka-lance-plusieurs-projets-pour-renforcer-le-reseau-routier-100144284/">Khénifra : Nizar Baraka lance plusieurs projets pour renforcer le réseau routier</a></span> <p class="p-tp-sm-top">Politique - Le ministre lance des projets pour renforcer la connectivité à Khénifra et améliorer les infrastructures routières locales.</p> <small style="color:#7e7277"><span><a href="https://www.lebrief.ma/author/mouna-aghlal/">Mouna Aghlal</a> - <span>10 mars 2026</span></span></small> </div> </div><!-- WPV_Infinite_Scroll --><span class="seemore"></span> </section> </div> </div></div></div><div class="col-12 col-sm-12 col-md-12 col-lg-3 col-xl-3 newsletter"> <!-- <form action="https://app.fidelyze.com/lists/65816b534169b/embedded-form-subscribe-captcha" method="POST" class="form-validate-jqueryz" accept-charset="utf-8"> <h4>La newsletter qui vous bri