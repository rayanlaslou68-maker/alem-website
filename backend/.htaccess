Options -Indexes
Options -FollowSymLinks

<FilesMatch "\.(env|ini|log|sql)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>

RewriteEngine On
RewriteCond %{REQUEST_URI} ^/(config|lib)/ [NC]
RewriteRule .* - [F,L]